# ===========================================
# CryptoPlace Environment Configuration
# ===========================================

# Blockchain Mode Toggle
# true = use ethers.js + MetaMask + Sepolia blockchain
# false = use backend database + wallet service
VITE_USE_ETHERS=false

# Blockchain Settings (used when VITE_USE_ETHERS=true)
VITE_RPC_URL=https://sepolia.infura.io/v3/85557bf2c0284e4ab404da743eaaf676
VITE_CHAIN_ID=11155111
VITE_NETWORK_NAME=sepolia

# Backend API Settings
VITE_API_BASE_URL=http://localhost:3000/api

# App Mode
VITE_APP_MODE=development
